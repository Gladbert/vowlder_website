---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  bare?: boolean;
}

const { title, description, image = '/og/default.png', bare = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/brand/vowlder-mark.png" type="image/png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vowlder" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#f7f3ec" />
    <slot name="head" />
  </head>
  <body class="min-h-[100svh]">
    {
      !bare && (
        <header class="sticky top-0 z-40 border-b border-line/70 bg-cream/85 backdrop-blur">
          <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8">
            <a href="/" class="flex items-center gap-2.5" aria-label="Vowlder — beranda">
              <img src="/brand/vowlder-mark.png" alt="" width="28" height="28" class="h-7 w-7" />
              <img src="/brand/vowlder-name.png" alt="Vowlder" width="102" height="16" class="h-4 w-auto" />
            </a>
            <nav class="flex items-center gap-5 text-sm">
              <a href="#tema" class="hidden text-ink-soft hover:text-ink sm:inline">
                Tema
              </a>
              <a href="#cara-pesan" class="hidden text-ink-soft hover:text-ink sm:inline">
                Cara pesan
              </a>
              <a
                href="#tema"
                class="rounded-full bg-ink px-4 py-2 text-xs font-medium tracking-wide text-cream hover:bg-ink-soft"
              >
                Lihat katalog
              </a>
            </nav>
          </div>
        </header>
      )
    }
    <slot />
    {
      !bare && (
        <footer class="border-t border-line">
          <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-10 sm:flex-row sm:items-end sm:justify-between sm:px-8">
            <div>
              <img
                src="/brand/vowlder-name.png"
                alt="Vowlder"
                width="102"
                height="16"
                class="h-4 w-auto"
              />
              <p class="mt-3 max-w-xs text-sm leading-relaxed text-ink-soft">
                Undangan pernikahan digital. Dibuat di Indonesia, dikirim lewat WhatsApp.
              </p>
            </div>
            <div class="text-sm text-ink-soft">
              <a href="mailto:halo@vowlder.com" class="hover:text-ink">halo@vowlder.com</a>
              <p class="mt-1.5">© {new Date().getFullYear()} Vowlder</p>
            </div>
          </div>
        </footer>
      )
    }
  </body>
</html>
