---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { WA_NUMBER } from '../data/themes';

interface Props {
  title: string;
  description: string;
  image?: string;
  bare?: boolean;
}

const { title, description, image = '/og/default.png', bare = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

const links = [
  { href: '/themes', label: 'Themes' },
  { href: '/packages', label: 'Packages' },
  { href: '/process', label: 'Process' },
  { href: '/about', label: 'About' },
  { href: '/faq', label: 'FAQ' },
  { href: '/custom', label: 'Custom design' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/brand/vowlder-name.png" type="image/png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vowlder" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#fbf9f5" />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="min-h-[100svh]">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-100 focus:rounded-pill focus:bg-ink focus:px-4 focus:py-3 focus:text-sm focus:text-cream"
    >
      Skip to content
    </a>
    {
      !bare && (
        <header class="sticky top-0 z-40 border-b border-line bg-cream/92 backdrop-blur">
          <div class="mx-auto max-w-6xl px-5 sm:px-8">
            <div class="flex h-14 items-center justify-between gap-4">
              <a href="/" aria-label="Vowlder home" class="flex min-h-[44px] shrink-0 items-center">
                <img
                  src="/brand/vowlder-name.png"
                  alt="Vowlder"
                  width="128"
                  height="20"
                  class="h-5 w-auto"
                />
              </a>

              <nav aria-label="Main" class="hidden items-center gap-6 text-sm md:flex">
                {links.slice(0, 4).map((link) => (
                  <a
                    href={link.href}
                    aria-current={isActive(link.href) ? 'page' : undefined}
                    class:list={[
                      'flex min-h-[40px] items-center transition-colors hover:text-ink',
                      isActive(link.href) ? 'text-ink' : 'text-ink-soft',
                    ]}
                  >
                    {link.label}
                  </a>
                ))}
              </nav>

              <a
                href={`https://wa.me/${WA_NUMBER}`}
                target="_blank"
                rel="noopener"
                class="flex min-h-[40px] shrink-0 items-center rounded-pill bg-ink px-4 text-xs font-medium text-cream hover:bg-ink-soft"
              >
                Order
              </a>
            </div>

            {/* Phones: one scrollable row instead of a hamburger. Always visible, no JS. */}
            <div class="-mx-5 overflow-x-auto px-5 md:hidden">
              <nav aria-label="Sections" class="flex gap-5 pb-2 text-[12.5px] whitespace-nowrap">
                {links.map((link) => (
                  <a
                    href={link.href}
                    aria-current={isActive(link.href) ? 'page' : undefined}
                    class:list={[
                      'flex min-h-[44px] items-center transition-colors hover:text-ink',
                      isActive(link.href) ? 'text-ink underline underline-offset-4' : 'text-ink-soft',
                    ]}
                  >
                    {link.label}
                  </a>
                ))}
              </nav>
            </div>
          </div>
        </header>
      )
    }

    <div id="main">
      <slot />
    </div>

    {
      !bare && (
        <footer class="border-t border-line">
          <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-14">
            <div class="grid gap-9 lg:grid-cols-[1.3fr_1fr_1fr]">
              <div>
                <img
                  src="/brand/vowlder-name.png"
                  alt="Vowlder"
                  width="128"
                  height="20"
                  class="h-5 w-auto"
                />
                <p class="mt-3 max-w-xs text-sm leading-relaxed text-ink-soft">
                  Digital wedding invitations, built one at a time in Surabaya. One link per guest,
                  sent over WhatsApp.
                </p>
                <p class="mt-3 max-w-xs text-sm leading-relaxed text-ink-soft">
                  Managed guest lists, WhatsApp broadcast, and QR check-in at the door.
                </p>
              </div>

              {/* Phones get these two columns side by side, so the footer stays short. */}
              <div class="grid grid-cols-2 gap-6">
                <nav aria-label="Pages">
                  <p class="eyebrow">Explore</p>
                  <ul class="mt-2">
                    {links.map((link) => (
                      <li>
                        <a
                          href={link.href}
                          aria-current={isActive(link.href) ? 'page' : undefined}
                          class="flex min-h-[40px] items-center text-sm text-ink-soft hover:text-ink"
                        >
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>

                <nav aria-label="More">
                  <p class="eyebrow">More</p>
                  <ul class="mt-2">
                    {[
                      { href: '/guide', label: 'Notes' },
                      { href: '/faq', label: 'FAQ' },
                      { href: '/contact', label: 'Contact' },
                      { href: '/privacy', label: 'Privacy' },
                      { href: '/terms', label: 'Terms' },
                    ].map((link) => (
                      <li>
                        <a
                          href={link.href}
                          aria-current={isActive(link.href) ? 'page' : undefined}
                          class="flex min-h-[40px] items-center text-sm text-ink-soft hover:text-ink"
                        >
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </div>

              <div>
                <p class="eyebrow">Contact</p>
                <ul class="mt-2 text-sm text-ink-soft">
                  <li>
                    <a
                      href={`https://wa.me/${WA_NUMBER}`}
                      target="_blank"
                      rel="noopener"
                      class="flex min-h-[40px] items-center hover:text-ink"
                    >
                      WhatsApp
                    </a>
                  </li>
                  <li>
                    <a href="mailto:hello@vowlder.com" class="flex min-h-[40px] items-center hover:text-ink">
                      hello@vowlder.com
                    </a>
                  </li>
                  <li class="flex min-h-[40px] items-center">Surabaya, Indonesia</li>
                  <li class="flex min-h-[40px] items-center">Replies within one working day</li>
                </ul>
              </div>
            </div>

            <div
              class="mt-10 flex flex-col gap-2 border-t border-line pt-5 text-xs text-ink-soft sm:flex-row sm:items-center sm:justify-between"
            >
              <p>© {new Date().getFullYear()} Vowlder</p>
              <p>Made in Surabaya. Photographs by the couples.</p>
            </div>
          </div>
        </footer>
      )
    }
    <script>
      // Site chrome only: reveal-on-scroll and a header hairline. No island, no
      // framework. Re-runs after every view transition, so listeners never stack.
      let observers: IntersectionObserver[] = [];

      function initChrome() {
        for (const observer of observers) observer.disconnect();
        observers = [];

        const header = document.querySelector('header');
        const onScroll = () => {
          header?.classList.toggle('shadow-[0_1px_0_0_var(--color-line)]', window.scrollY > 8);
        };
        onScroll();
        window.removeEventListener('scroll', onScroll);
        window.addEventListener('scroll', onScroll, { passive: true });

        const targets = document.querySelectorAll('[data-rise]:not(.is-in)');
        if (!targets.length) return;

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        for (const target of targets) observer.observe(target);
        observers.push(observer);
      }

      initChrome();
      document.addEventListener('astro:page-load', initChrome);
    </script>
  </body>
</html>
