---
interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-line border-y border-line">
  {
    items.map((item) => (
      <details class="group py-4">
        <summary class="flex min-h-[40px] cursor-pointer list-none items-start justify-between gap-4">
          <h2 class="text-base font-medium">{item.q}</h2>
          <span
            aria-hidden="true"
            class="mt-1 shrink-0 text-lg leading-none text-brass transition-transform duration-200 group-open:rotate-45"
          >
            +
          </span>
        </summary>
        <p class="lede mt-2 max-w-xl">{item.a}</p>
      </details>
    ))
  }
</div>
