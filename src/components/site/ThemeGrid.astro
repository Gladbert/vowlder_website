---
import ThemeCard from '../ThemeCard.astro';
import { categories, themes } from '../../data/themes';

interface Props {
  /** Only render this many cards (home teaser). Filters stay hidden when limited. */
  limit?: number;
}

const { limit } = Astro.props;
const shown = limit ? themes.slice(0, limit) : themes;
---

{
  !limit && (
    <div class="sticky top-[5.5rem] z-20 -mx-5 overflow-x-auto bg-cream/95 px-5 py-2 backdrop-blur sm:static sm:mx-0 sm:overflow-visible sm:bg-transparent sm:px-0 sm:py-0 sm:backdrop-blur-none">
      <div class="flex gap-2" role="group" aria-label="Filter themes by category">
        <button
          type="button"
          data-filter="All"
          aria-pressed="true"
          class="min-h-[38px] shrink-0 rounded-pill border border-ink px-4 text-xs font-medium tracking-wide whitespace-nowrap"
        >
          All
        </button>
        {categories.map((category) => (
          <button
            type="button"
            data-filter={category}
            aria-pressed="false"
            class="min-h-[38px] shrink-0 rounded-pill border border-ink/15 px-4 text-xs font-medium tracking-wide whitespace-nowrap hover:border-ink/40"
          >
            {category}
          </button>
        ))}
      </div>
    </div>
  )
}

<div
  id="theme-grid"
  class:list={[
    'grid grid-cols-1 gap-y-6 sm:grid-cols-2 sm:gap-x-7 sm:gap-y-12 lg:grid-cols-3',
    !limit && 'mt-8',
  ]}
>
  {shown.map((theme) => <ThemeCard theme={theme} />)}
</div>

<p id="theme-empty" class="mt-9 hidden text-sm text-ink-soft">Nothing in this category yet.</p>

{
  !limit && (
    <script>
      const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
      const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-theme-card]'));
      const empty = document.getElementById('theme-empty');

      for (const button of buttons) {
        button.addEventListener('click', () => {
          const filter = button.dataset.filter ?? 'All';
          let visible = 0;

          for (const card of cards) {
            const show = filter === 'All' || card.dataset.category === filter;
            card.hidden = !show;
            if (show) visible++;
          }

          for (const other of buttons) {
            const active = other === button;
            other.setAttribute('aria-pressed', String(active));
            other.classList.toggle('border-ink', active);
            other.classList.toggle('border-ink/15', !active);
          }

          empty?.classList.toggle('hidden', visible > 0);
        });
      }
    </script>
  )
}
