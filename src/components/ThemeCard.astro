---
import type { Theme } from '../data/themes';
import { rupiah, waLink } from '../data/themes';
import ThemeThumb from './ThemeThumb.astro';

interface Props {
  theme: Theme;
}

const { theme } = Astro.props;
const previewUrl = new URL(`/preview/${theme.slug}/`, Astro.site).href;
---

<article data-theme-card data-category={theme.category} class="flex flex-col">
  <a
    href={`/preview/${theme.slug}/`}
    class="block transition-transform duration-300 hover:-translate-y-1"
    aria-label={`Open the ${theme.name} preview`}
  >
    <ThemeThumb theme={theme} class="aspect-[9/16]" />
  </a>

  <div class="mt-4 flex items-baseline justify-between gap-3">
    <h3 class="font-brand text-xl leading-tight sm:text-2xl">{theme.name}</h3>
    <p class="shrink-0 text-sm tabular-nums text-ink-soft">{rupiah(theme.price)}</p>
  </div>

  <p class="mt-1 eyebrow">{theme.category} · {theme.mood}</p>
  <p class="mt-2 text-sm leading-relaxed text-ink-soft">{theme.blurb}</p>

  <div class="mt-4 flex flex-wrap gap-2">
    <a
      href={`/preview/${theme.slug}/`}
      class="flex min-h-[38px] items-center rounded-pill border border-ink/15 px-4 text-xs font-medium hover:border-ink/40"
    >
      Live preview
    </a>
    <a
      href={waLink(theme, previewUrl)}
      target="_blank"
      rel="noopener"
      class="flex min-h-[38px] items-center rounded-pill bg-ink px-4 text-xs font-medium text-cream hover:bg-ink-soft"
    >
      Order on WhatsApp
    </a>
  </div>
</article>
