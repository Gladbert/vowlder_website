---
import Base from '../../layouts/Base.astro';
import GuestTester from '../../components/GuestTester.astro';
import Invitation from '../../components/previews/Invitation';
import ThemeThumb from '../../components/ThemeThumb.astro';
import { includedFeatures, rupiah, themes, waLink } from '../../data/themes';
import { wedding } from '../../data/wedding';

export function getStaticPaths() {
  return themes.map((theme) => ({ params: { slug: theme.slug }, props: { theme } }));
}

const { theme } = Astro.props;
const previewUrl = new URL(`/preview/${theme.slug}/`, Astro.site).href;
const others = themes.filter((item) => item.slug !== theme.slug).slice(0, 3);
---

<Base
  bare
  title={`${theme.name} — undangan pernikahan digital | Vowlder`}
  description={theme.blurb}
  image={`/og/${theme.slug}.png`}
>
  <div class="min-h-[100svh] bg-cream">
    <header class="sticky top-0 z-40 border-b border-line bg-cream/95 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-3 px-4 sm:px-8">
        <a href="/" class="flex shrink-0 items-center gap-2 text-sm text-ink-soft hover:text-ink">
          <span aria-hidden="true">←</span> Katalog
        </a>
        <p class="min-w-0 truncate text-sm font-medium">{theme.name}</p>
        <a
          href={waLink(theme, previewUrl)}
          target="_blank"
          rel="noopener"
          class="shrink-0 rounded-full bg-ink px-3.5 py-1.5 text-xs font-medium text-cream hover:bg-ink-soft"
        >
          Pesan
        </a>
      </div>
      <!-- Phone: the tester has to stay reachable without scrolling 5 000 px of invitation. -->
      <div class="lg:hidden">
        <GuestTester variant="bar" id="bar" />
      </div>
    </header>

    <main class="mx-auto max-w-6xl sm:px-8 sm:pt-8 lg:grid lg:grid-cols-[420px_minmax(0,1fr)] lg:items-start lg:gap-14">
      <div
        id="undangan"
        class="relative mx-auto h-[calc(100svh-6.25rem)] w-full overflow-hidden bg-paper sm:max-w-[420px] sm:rounded-[2rem] sm:border sm:border-line sm:shadow-[0_30px_80px_-50px_rgba(43,35,32,0.6)] lg:h-[calc(100svh-9rem)] lg:max-w-none"
      >
        <Invitation theme={theme} client:load />
      </div>

      <aside id="info" class="scroll-mt-28 px-5 pt-10 pb-16 sm:px-0 lg:pt-2">
        <p class="eyebrow">{theme.category} · {theme.mood} · {theme.tier}</p>
        <h1 class="mt-2 font-display text-3xl leading-tight font-medium sm:text-4xl">{theme.name}</h1>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-ink-soft">{theme.blurb}</p>

        <p class="mt-5 font-display text-2xl">{rupiah(theme.price)}</p>
        <p class="mt-1 text-xs text-ink-soft">Sekali bayar. Aktif 12 bulan. Revisi 2 kali.</p>

        <div class="mt-6 hidden lg:block">
          <GuestTester variant="card" id="card" />
        </div>

        <p class="mt-6 max-w-sm rounded-xl border border-line bg-paper/70 p-3.5 text-xs leading-relaxed text-ink-soft lg:mt-4">
          Ketuk <span class="font-medium text-ink">Buka Undangan</span> untuk masuk. Nama yang Anda isi
          di atas langsung masuk ke undangan, dan tautannya bisa dikirim ke pasangan.
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={waLink(theme, previewUrl)}
            target="_blank"
            rel="noopener"
            class="rounded-full bg-ink px-5 py-3 text-sm font-medium text-cream hover:bg-ink-soft"
          >
            Pesan tema ini
          </a>
          <a
            href="#undangan"
            class="rounded-full border border-ink/20 px-5 py-3 text-sm font-medium hover:border-ink/50"
          >
            Ke undangan
          </a>
        </div>

        <div class="mt-8">
          <p class="eyebrow">Yang selalu ada</p>
          <p class="mt-2 max-w-md text-sm leading-relaxed text-ink-soft">
            Tema ini memakai undangan yang sama dengan tema lain: {wedding.couple.groom.nickname} &amp;
            {wedding.couple.bride.nickname}, {wedding.event.dateLabel}, di {wedding.event.venue}.
          </p>
          <ul class="mt-3 grid gap-1.5 text-sm sm:grid-cols-2">
            {
              includedFeatures.map((feature) => (
                <li class="flex items-start gap-2 leading-relaxed">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-brass" />
                  {feature}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="mt-10">
          <p class="eyebrow">Tema lain</p>
          <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4">
            {
              others.map((item) => (
                <a href={`/preview/${item.slug}/`} class="group">
                  <ThemeThumb theme={item} class="aspect-[9/16]" />
                  <p class="mt-2 text-xs leading-tight group-hover:underline">{item.name}</p>
                </a>
              ))
            }
          </div>
          <a href="/" class="mt-4 inline-block text-sm text-ink-soft underline underline-offset-4 hover:text-ink">
            Lihat {themes.length} tema
          </a>
        </div>
      </aside>
    </main>
  </div>
</Base>
