---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/site/PageIntro.astro';
import ThemeGrid from '../../components/site/ThemeGrid.astro';
import ContactCta from '../../components/site/ContactCta.astro';
import { includedFeatures, themes } from '../../data/themes';
import { wedding } from '../../data/wedding';
---

<Base
  title="All themes · Vowlder"
  description={`The full catalogue: ${themes.length} digital wedding invitation designs. Same invitation in every one, different palette, type, and layout.`}
>
  <main>
    <PageIntro
      eyebrow="The catalogue"
      title={`${themes.length} designs, one invitation`}
      lede={`Every theme runs the same invitation: ${wedding.couple.groom.nickname} & ${wedding.couple.bride.nickname}, ${wedding.event.dateLabel}. Only the colour, type, and layout change.`}
    />

    <section class="mx-auto max-w-6xl px-5 pb-14 sm:px-8">
      <ThemeGrid />

      <div class="mt-10 border-t border-line pt-6">
        <p class="eyebrow">In every design</p>
        <ul class="mt-3 grid gap-x-8 gap-y-2 text-sm sm:grid-cols-2 lg:grid-cols-4">
          {
            includedFeatures.map((item) => (
              <li class="flex gap-2.5 leading-relaxed">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-brass" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <ContactCta
      title="Found one? Tell us the date."
      body="We will confirm availability the same day and send the first draft within a week."
    />
  </main>
</Base>
