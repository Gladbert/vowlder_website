---
import Base from '../layouts/Base.astro';
import { themes } from '../data/themes';
---

<Base
  title="Page not found · Vowlder"
  description="That page does not exist. Head back to the theme catalogue."
>
  <main class="mx-auto flex min-h-[70svh] max-w-6xl flex-col justify-center px-5 py-16 sm:px-8">
    <p class="eyebrow">404</p>
    <h1 class="display-2 mt-3 max-w-lg">
      This page does not exist. The theme you were after may have been renamed.
    </h1>
    <p class="mt-4 max-w-md text-sm leading-relaxed text-ink-soft">
      There are {themes.length} themes in the catalogue, all showing the same invitation.
    </p>
    <div class="mt-7 flex flex-col gap-2.5 sm:flex-row sm:flex-wrap sm:gap-3">
      <a
        href="/"
        class="flex min-h-[48px] items-center justify-center rounded-full bg-ink px-5 py-3 text-sm font-medium text-cream hover:bg-ink-soft"
      >
        Back to the catalogue
      </a>
    </div>
  </main>
</Base>
