---
import Base from '../layouts/Base.astro';
---

<Base
  title="Halaman tidak ditemukan — Vowlder"
  description="Halaman yang Anda cari tidak ada. Kembali ke katalog tema undangan Vowlder."
>
  <main class="mx-auto flex min-h-[70svh] max-w-6xl flex-col justify-center px-5 py-16 sm:px-8">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 max-w-lg font-display text-3xl leading-tight font-medium sm:text-4xl">
      Halaman ini tidak ada. Tema yang Anda cari mungkin sudah berganti nama.
    </h1>
    <div class="mt-7 flex flex-wrap gap-3">
      <a href="/" class="rounded-full bg-ink px-5 py-3 text-sm font-medium text-cream hover:bg-ink-soft">
        Kembali ke katalog
      </a>
    </div>
  </main>
</Base>
