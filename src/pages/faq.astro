---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/site/PageIntro.astro';
import Faq from '../components/site/Faq.astro';
import ContactCta from '../components/site/ContactCta.astro';

const faqs = [
  {
    q: 'How long does it take?',
    a: 'Two to three working days from the moment we have your details and photos. Signature themes can be quicker if the queue is empty.',
  },
  {
    q: 'Do guests need to install anything?',
    a: 'No. It is a web page. It opens in the browser that is already on their phone, including older Android devices.',
  },
  {
    q: 'How do guests receive the invitation?',
    a: 'One link per guest, sent over WhatsApp. The guest name comes from the link, so nobody has to type their own name.',
  },
  {
    q: 'Can we change the wording?',
    a: 'Yes. Two rounds of edits are included with every package. After that we charge per round, which we will tell you upfront.',
  },
  {
    q: 'What happens to the RSVPs?',
    a: 'They land in our dashboard, not in your personal chat. You get the tally every day, and a final list the morning of the reception.',
  },
  {
    q: 'Can it live on our own domain?',
    a: 'Yes. We can put the invitation on your domain, or use a short link we provide. Either way it stays up for twelve months.',
  },
  {
    q: 'What if we move the date?',
    a: 'We move the invitation with it, once, at no charge. Before the guest links go out, a date change is a two-minute edit.',
  },
  {
    q: 'Do you add music?',
    a: 'Yes, one looped track, and it only starts when a guest taps "Open Invitation". Browsers block anything that plays by itself.',
  },
  {
    q: 'Can we get the photos afterwards?',
    a: 'The originals are yours already. We only keep the compressed versions that the page needs.',
  },
];
---

<Base
  title="Questions · Vowlder"
  description="Answers about turnaround, guest links, RSVP, edits, domains, music, and what happens after the reception."
>
  <main>
    <PageIntro eyebrow="Questions" title="The ones we get most" lede="If yours is not here, message us. The answer is usually one paragraph." />

    <section class="mx-auto max-w-6xl px-5 pb-14 sm:px-8">
      <Faq items={faqs} />
    </section>

    <ContactCta title="Still wondering?" body="Send the question. No obligation and no sales script." />
  </main>
</Base>
