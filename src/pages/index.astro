---
import Base from '../layouts/Base.astro';
import ThemeCard from '../components/ThemeCard.astro';
import ThemeThumb from '../components/ThemeThumb.astro';
import { categories, rupiah, themes, WA_NUMBER } from '../data/themes';

const [featured] = themes;
const fromPrice = rupiah(Math.min(...themes.map((theme) => theme.price)));
const included = [
  'Nama tamu otomatis dari tautan',
  'Peta lokasi & tombol simpan tanggal',
  'Konfirmasi kehadiran ke WhatsApp',
  'Aktif 12 bulan, revisi 2 kali',
];
const steps = [
  { title: 'Pilih tema', body: 'Buka live preview, cek di ponsel sendiri. Semua tema bisa diganti isi.' },
  { title: 'Kirim detail acara', body: 'Nama, tanggal, lokasi, foto, dan susunan acara lewat WhatsApp.' },
  { title: 'Terima link', body: 'Link undangan siap dibagikan dalam 2–3 hari kerja.' },
];
---

<Base
  title="Vowlder — Undangan pernikahan digital"
  description="Katalog tema undangan pernikahan digital. Satu link per tamu, dikirim lewat WhatsApp, sudah dirapikan untuk layar ponsel."
>
  <main>
    <!-- Hero -->
    <section class="mx-auto max-w-6xl px-5 pt-10 pb-14 sm:px-8 sm:pt-16 sm:pb-20">
      <div class="grid items-center gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
        <div>
          <p class="eyebrow">{themes.length} tema · katalog 2026</p>
          <h1
            class="mt-4 text-[2.15rem] leading-[1.08] font-display font-medium tracking-tight text-balance sm:text-5xl lg:text-6xl"
          >
            Undangan pernikahan digital yang dikirim lewat WhatsApp.
          </h1>
          <p class="mt-5 max-w-md text-[0.95rem] leading-relaxed text-ink-soft sm:text-base">
            Buka undangan, nama tamu langsung terisi dari tautan. Tidak ada aplikasi yang perlu diunduh,
            tidak ada form panjang.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href="#tema"
              class="rounded-full bg-ink px-5 py-3 text-sm font-medium text-cream hover:bg-ink-soft"
            >
              Lihat katalog tema
            </a>
            <a
              href={`https://wa.me/${WA_NUMBER}`}
              target="_blank"
              rel="noopener"
              class="rounded-full border border-ink/20 px-5 py-3 text-sm font-medium hover:border-ink/50"
            >
              Tanya dulu
            </a>
          </div>

          <p class="mt-5 text-sm text-ink-soft">Mulai {fromPrice}. Sekali bayar, tanpa langganan.</p>
        </div>

        <div class="justify-self-center lg:justify-self-end">
          <a href={`/preview/${featured.slug}/`} class="block w-[15.5rem] sm:w-[17rem]">
            <ThemeThumb theme={featured} class="aspect-[9/17] shadow-[0_24px_60px_-32px_rgba(43,35,32,0.5)]" />
          </a>
        </div>
      </div>
    </section>

    <!-- Catalog -->
    <section id="tema" class="scroll-mt-16 border-t border-line">
      <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="eyebrow">Katalog</p>
            <h2 class="mt-2 font-display text-3xl font-medium sm:text-4xl">Pilih tema</h2>
          </div>
          <p class="max-w-xs text-sm leading-relaxed text-ink-soft">
            Semua tema bisa diganti warna, huruf, dan isinya. Yang di bawah ini versi awal.
          </p>
        </div>

        <div class="mt-7 -mx-5 overflow-x-auto px-5 pb-1 sm:mx-0 sm:overflow-visible sm:px-0">
          <div class="flex gap-2" role="group" aria-label="Filter kategori tema">
            <button
              type="button"
              data-filter="Semua"
              aria-pressed="true"
              class="shrink-0 rounded-full border border-ink px-4 py-2 text-xs font-medium tracking-wide whitespace-nowrap">Semua</button
            >
            {
              categories.map((category) => (
                <button
                  type="button"
                  data-filter={category}
                  aria-pressed="false"
                  class="shrink-0 rounded-full border border-ink/15 px-4 py-2 text-xs font-medium tracking-wide whitespace-nowrap hover:border-ink/40"
                >
                  {category}
                </button>
              ))
            }
          </div>
        </div>

        <div id="tema-grid" class="mt-9 grid grid-cols-1 gap-x-7 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {themes.map((theme) => <ThemeCard theme={theme} />)}
        </div>

        <p id="tema-empty" class="mt-9 hidden text-sm text-ink-soft">Belum ada tema di kategori ini.</p>
      </div>
    </section>

    <!-- Included -->
    <section class="border-t border-line bg-paper/60">
      <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8">
        <p class="eyebrow">Termasuk di semua tema</p>
        <ul class="mt-4 grid gap-x-8 gap-y-3 text-sm sm:grid-cols-2 lg:grid-cols-4">
          {
            included.map((item) => (
              <li class="flex gap-2.5 leading-relaxed">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-brass" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Steps -->
    <section id="cara-pesan" class="scroll-mt-16 border-t border-line">
      <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
        <p class="eyebrow">Cara pesan</p>
        <h2 class="mt-2 font-display text-3xl font-medium sm:text-4xl">Tiga langkah</h2>

        <ol class="mt-8 grid gap-8 sm:grid-cols-3 sm:gap-6">
          {
            steps.map((step, i) => (
              <li class="border-t border-line pt-4">
                <span class="text-xs tabular-nums text-brass">0{i + 1}</span>
                <h3 class="mt-2 text-base font-medium">{step.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{step.body}</p>
              </li>
            ))
          }
        </ol>

        <a
          href={`https://wa.me/${WA_NUMBER}`}
          target="_blank"
          rel="noopener"
          class="mt-10 inline-flex rounded-full bg-ink px-5 py-3 text-sm font-medium text-cream hover:bg-ink-soft"
        >
          Mulai dari WhatsApp
        </a>
      </div>
    </section>
  </main>
</Base>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-theme-card]'));
  const empty = document.getElementById('tema-empty');

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter ?? 'Semua';
      let visible = 0;

      for (const card of cards) {
        const show = filter === 'Semua' || card.dataset.category === filter;
        card.hidden = !show;
        if (show) visible++;
      }

      for (const other of buttons) {
        const active = other === button;
        other.setAttribute('aria-pressed', String(active));
        other.classList.toggle('border-ink', active);
        other.classList.toggle('border-ink/15', !active);
      }

      empty?.classList.toggle('hidden', visible > 0);
    });
  }
</script>
