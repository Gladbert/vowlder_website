---
import Base from '../layouts/Base.astro';
import ThemeCard from '../components/ThemeCard.astro';
import ThemeThumb from '../components/ThemeThumb.astro';
import ContactCta from '../components/site/ContactCta.astro';
import { rupiah, themes, WA_NUMBER } from '../data/themes';

const [featured] = themes;
const fromPrice = rupiah(Math.min(...themes.map((theme) => theme.price)));

const services = [
  {
    title: 'The invitation',
    body: 'One page per couple: both ceremonies, the venue, the map, your story, a gallery, RSVP, and a guest book. Laid out for a phone, because that is where it will be opened.',
    href: '/themes',
    cta: 'See the designs',
  },
  {
    title: 'The guest list',
    body: 'Every guest gets their own link, so their name is already on the invitation. Replies come back to us, and we send you the tally daily until the ceremony.',
    href: '/packages',
    cta: 'What it costs',
  },
  {
    title: 'The day itself',
    body: 'The page stays live through the reception. You get a check-in list for the door, and printed QR cards if you would rather not ask people to queue.',
    href: '/process',
    cta: 'How it runs',
  },
];
---

<Base
  title="Vowlder · Digital wedding invitations, built in Surabaya"
  description="Wedding invitations as a single web page: one link per guest, both ceremonies, RSVP, gallery, guest book. From Rp 175,000, one payment."
>
  <main>
    <!-- Hero -->
    <section class="mx-auto max-w-6xl px-5 pt-10 pb-12 sm:px-8 sm:pt-16 sm:pb-20">
      <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-16">
        <div data-rise>
          <p class="eyebrow">Digital invitations · Surabaya</p>
          <h1 class="display-1 words mt-4 max-w-[18ch]">
            {
              'Invitations that arrive as a link, not an envelope.'
                .split(' ')
                .map((word, index) => (
                  <span style={`--d: ${index}`}>{word}&nbsp;</span>
                ))
            }
          </h1>
          <p class="lede mt-5 max-w-md">
            We build one web page per couple. One link per guest, their name already inside it.
            Nothing to install, nothing to print unless you want to.
          </p>

          <div class="mt-7 flex flex-col gap-2.5 sm:flex-row sm:items-center sm:gap-3">
            <a
              href="/themes"
              class="press press-active flex min-h-[48px] items-center justify-center rounded-pill bg-ink px-6 text-sm font-medium text-cream hover:bg-ink-soft"
            >
              See the {themes.length} themes
            </a>
            <a
              href={`https://wa.me/${WA_NUMBER}`}
              target="_blank"
              rel="noopener"
              class="flex min-h-[48px] items-center justify-center rounded-pill border border-ink/20 px-6 text-sm font-medium hover:border-ink/50"
            >
              Order on WhatsApp
            </a>
          </div>

          <dl class="mt-8 grid grid-cols-3 gap-4 border-t border-line pt-5 text-sm">
            <div>
              <dt class="eyebrow">From</dt>
              <dd class="mt-1">{fromPrice}</dd>
            </div>
            <div>
              <dt class="eyebrow">Payment</dt>
              <dd class="mt-1">Once, no renewal</dd>
            </div>
            <div>
              <dt class="eyebrow">Live for</dt>
              <dd class="mt-1">12 months</dd>
            </div>
          </dl>
        </div>

        <div data-rise style="--i: 1" class="lg:justify-self-end">
          <a href={`/preview/${featured.slug}/`} class="mx-auto block w-[15rem] sm:w-[18rem]">
            <ThemeThumb theme={featured} class="aspect-[9/17] shadow-[0_30px_70px_-45px_rgba(26,25,23,0.6)]" />
            <span class="mt-3 block text-center text-xs text-ink-soft">
              The invitation we built for our own wedding
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- Ribbon: the catalogue as a moving index, not a badge wall. -->
    <section aria-hidden="true" class="overflow-hidden border-y border-line bg-paper/40">
      <div class="ribbon py-3">
        {[0, 1].map(() => (
          <div class="flex shrink-0 items-center gap-6 pr-6">
            {themes.map((theme) => (
              <span class="flex items-center gap-6 text-[11px] tracking-[0.18em] uppercase text-ink-soft/70">
                {theme.name}
                <span class="h-1 w-1 rounded-full bg-brass/60" />
              </span>
            ))}
          </div>
        ))}
      </div>
    </section>

    <!-- Services -->
    <section class="border-t border-line">
      <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
        <p class="eyebrow">What we do</p>
        <div class="mt-6 divide-y divide-line border-y border-line">
          {
            services.map((service, index) => (
              <div class="grid gap-2 py-6 sm:grid-cols-[7rem_1fr] sm:gap-8" data-rise style={`--i: ${index + 1}`}>
                <span class="text-xs tabular-nums text-brass">0{index + 1}</span>
                <div>
                  <h2 class="display-2">{service.title}</h2>
                  <p class="lede mt-2 max-w-xl">{service.body}</p>
                  <a
                    href={service.href}
                    class="mt-3 inline-flex min-h-[40px] items-center text-sm text-ink-soft underline underline-offset-4 hover:text-ink"
                  >
                    {service.cta}
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Catalogue teaser -->
    <section class="border-t border-line">
      <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between" data-rise>
          <div>
            <p class="eyebrow">Selected designs</p>
            <h2 class="display-2 mt-2">Six of the {themes.length}</h2>
          </div>
          <a
            href="/themes"
            class="inline-flex min-h-[40px] items-center text-sm text-ink-soft underline underline-offset-4 hover:text-ink"
          >
            See the whole catalogue
          </a>
        </div>

        <div class="mt-6 grid grid-cols-1 gap-y-6 sm:grid-cols-2 sm:gap-x-7 sm:gap-y-12 lg:grid-cols-3">
          {themes.slice(0, 6).map((theme) => <ThemeCard theme={theme} />)}
        </div>
      </div>
    </section>

    <!-- Custom -->
    <section class="border-t border-line bg-paper/50">
      <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
        <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-16" data-rise>
          <div>
            <p class="eyebrow">Not in the catalogue</p>
            <h2 class="display-2 mt-2 max-w-[22ch]">We will build one around your palette.</h2>
            <p class="lede mt-3 max-w-md">
              Same structure, same turnaround, your colours and your typefaces. Send a mood board, a
              screenshot, or a fabric swatch. Anything beats an adjective.
            </p>
            <a
              href="/custom"
              class="mt-6 inline-flex min-h-[48px] items-center rounded-pill border border-ink/20 px-6 text-sm font-medium hover:border-ink/50"
            >
              How a custom design works
            </a>
          </div>

          <ul class="divide-y divide-line border-y border-line text-sm">
            <li class="flex items-start gap-3 py-3.5">
              <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-brass" />
              <span>Fixed quote in a day, first draft in a week</span>
            </li>
            <li class="flex items-start gap-3 py-3.5">
              <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-brass" />
              <span>Your section order, not ours</span>
            </li>
            <li class="flex items-start gap-3 py-3.5">
              <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-brass" />
              <span>One motion pass: how the cover opens, how sections arrive</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <ContactCta />
  </main>
</Base>
