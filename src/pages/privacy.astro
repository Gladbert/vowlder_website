---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/site/PageIntro.astro';

const items = [
  {
    heading: 'What we keep',
    body: [
      'The details you send us: both names, both sets of parents, the venue, the ceremonies, the photographs you choose, and any notes about the schedule.',
      'Guest replies: the name on the link, whether they are coming, how many seats, and an optional phone number. Nothing else.',
    ],
  },
  {
    heading: 'Where it lives',
    body: [
      'The invitation is a static page, so the design itself holds no personal data. Replies and wishes are stored in our own database, and the guest list is never sold, shared, or used for marketing.',
      'Preview hearts and preview RSVPs stay in the visitor\'s browser. They are labelled as previews in the interface because nothing is transmitted.',
    ],
  },
  {
    heading: 'How long we keep it',
    body: [
      'The invitation stays live for twelve months, then it is archived. Guest lists and replies are deleted twelve months after the last ceremony, or earlier if you ask.',
      'Originals you send us stay on our machines until the archive period ends, then they are removed. Keep your own copies.',
    ],
  },
  {
    heading: 'Your photographs',
    body: [
      'You keep the copyright to every photograph. We use the compressed versions the page needs, and we will not publish a couple\'s invitation as a portfolio piece without asking first.',
    ],
  },
  {
    heading: 'Cookies and tracking',
    body: [
      'The site sets no advertising cookies and loads no third-party trackers. If a Google map is opened, Google receives the request; that only happens when a guest presses the map button.',
    ],
  },
  {
    heading: 'Asking us to delete something',
    body: [
      'Write to hello@vowlder.com and name the invitation. We will remove the page and the replies, and confirm when it is done, usually within two working days.',
    ],
  },
];
---

<Base title="Privacy · Vowlder" description="What data a Vowlder invitation holds, where it lives, how long we keep it, and how to have it deleted.">
  <main>
    <PageIntro
      eyebrow="Privacy"
      title="What we hold, and for how long"
      lede="Plain language, because nobody reads a privacy page written by a lawyer."
      wide
    />

    <section class="mx-auto max-w-2xl px-5 pb-14 sm:px-8">
      {
        items.map((item, index) => (
          <section class="border-t border-line pt-5 pb-6" data-rise style={`--i: ${index % 3}`}>
            <h2 class="display-2">{item.heading}</h2>
            {item.body.map((paragraph) => (
              <p class="mt-3 text-[0.95rem] leading-[1.75] text-ink-soft">{paragraph}</p>
            ))}
          </section>
        ))
      }
      <p class="border-t border-line pt-5 text-xs text-ink-soft">
        Questions: <a href="mailto:hello@vowlder.com" class="underline underline-offset-4">hello@vowlder.com</a>
      </p>
    </section>
  </main>
</Base>
