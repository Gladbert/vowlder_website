---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/site/PageIntro.astro';
import ContactCta from '../../components/site/ContactCta.astro';
import { guides } from '../../data/guide';

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props;
const others = guides.filter((item) => item.slug !== guide.slug);
---

<Base title={`${guide.title} · Vowlder`} description={guide.description}>
  <main>
    <PageIntro eyebrow={`Notes · ${guide.readingMinutes} min read`} title={guide.title} lede={guide.lede} wide>
      <a
        href="/guide"
        class="mt-5 inline-flex min-h-[40px] items-center text-sm text-ink-soft underline underline-offset-4 hover:text-ink"
      >
        ← All notes
      </a>
    </PageIntro>

    <article class="mx-auto max-w-2xl px-5 pb-14 sm:px-8">
      {
        guide.sections.map((section, index) => (
          <section class="border-t border-line pt-5 pb-6" data-rise style={`--i: ${index % 3}`}>
            <h2 class="display-2">{section.heading}</h2>
            {section.body.map((paragraph) => (
              <p class="mt-3 text-[0.95rem] leading-[1.75] text-ink-soft">{paragraph}</p>
            ))}
          </section>
        ))
      }

      <p class="border-t border-line pt-5 text-xs text-ink-soft">Last updated {guide.updated}.</p>
    </article>

    {
      others.length > 0 && (
        <section class="border-t border-line bg-paper/50">
          <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
            <p class="eyebrow">Next</p>
            {others.map((item) => (
              <a href={`/guide/${item.slug}`} class="mt-3 block max-w-xl">
                <h2 class="display-2 hover:underline hover:underline-offset-4">{item.title}</h2>
                <p class="lede mt-1">{item.description}</p>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <ContactCta title="Questions about your own date?" />
  </main>
</Base>
