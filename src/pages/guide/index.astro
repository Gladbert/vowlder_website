---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/site/PageIntro.astro';
import ContactCta from '../../components/site/ContactCta.astro';
import { guides } from '../../data/guide';
---

<Base
  title="Notes · Vowlder"
  description="Short, practical notes about digital wedding invitations in Indonesia: what they cost, and how to send three hundred of them without losing track."
>
  <main>
    <PageIntro
      eyebrow="Notes"
      title="What we know, written down"
      lede="Two pieces we end up repeating on WhatsApp. Neither is a sales page."
    />

    <section class="mx-auto max-w-6xl px-5 pb-14 sm:px-8">
      <div class="divide-y divide-line border-y border-line">
        {
          guides.map((guide, index) => (
            <article class="py-6" data-rise style={`--i: ${index}`}>
              <p class="eyebrow">
                {guide.readingMinutes} min · updated {guide.updated}
              </p>
              <h2 class="display-2 mt-2 max-w-[24ch]">
                <a href={`/guide/${guide.slug}`} class="hover:underline hover:underline-offset-4">
                  {guide.title}
                </a>
              </h2>
              <p class="lede mt-2 max-w-xl">{guide.description}</p>
              <a
                href={`/guide/${guide.slug}`}
                class="mt-3 inline-flex min-h-[40px] items-center text-sm text-ink-soft underline underline-offset-4 hover:text-ink"
              >
                Read it
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <ContactCta title="Prefer to just ask?" body="Two paragraphs on WhatsApp usually beats reading. We are happy to answer either way." />
  </main>
</Base>
