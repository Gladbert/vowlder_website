---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/site/PageIntro.astro';
import ThemeCard from '../../components/ThemeCard.astro';
import ContactCta from '../../components/site/ContactCta.astro';
import { includedFeatures, rupiah, themes, WA_NUMBER } from '../../data/themes';

const tiers = {
  basic: {
    name: 'Invitation',
    tier: 'Basic' as const,
    summary: 'One page, both ceremonies, guest links. You send them; we hand them over.',
    lines: [
      'One ceremony in the schedule, with venue, map and Waze',
      'Guest links with the name already inside',
      'RSVP, wishes, and the guest book',
      'Eight photographs, countdown, save-the-date',
      'Twelve months live, two rounds of edits',
    ],
    notIncluded: [
      'WhatsApp broadcast to your guests',
      'Reply chasing and the daily tally',
      'On-site check-in or table assignment',
    ],
  },
  premium: {
    name: 'Managed',
    tier: 'Premium' as const,
    summary: 'We take the guest list off your hands: broadcast, chase, tally, and keep the invitation current.',
    lines: [
      'Everything in Invitation',
      'WhatsApp broadcast, sent in waves from our number, with your guests pre-filled',
      'Reply chasing: we follow up with anyone who has not answered by a date you set',
      'Daily tally to you by WhatsApp until the reception',
      'Guest book moderation, so the page stays readable',
      'A second ceremony with its own room and dress code',
    ],
    notIncluded: ['QR check-in at the door', 'Table assignment', 'Staffed booths on the day'],
  },
  signature: {
    name: 'Full service',
    tier: 'Signature' as const,
    summary: 'Everything managed, plus the door: QR check-in, table assignment, and staffed booths at the venue.',
    lines: [
      'Everything in Managed',
      'QR check-in: each guest gets a code that opens their seat and table',
      'Table assignment, changed until the morning of the event',
      'Two to four check-in devices, staffed by us, with a printed fallback list',
      'Printed QR cards for guests who do not use smartphones',
      'A live dashboard at the door: arrived, expected, walk-in',
      'A palette and typeface made for your photographs',
    ],
    notIncluded: ['Photography, printing of the invitation cards, or venue costs'],
  },
};

export function getStaticPaths() {
  return ['basic', 'premium', 'signature'].map((slug) => ({ params: { tier: slug }, props: { slug } }));
}

const { slug } = Astro.props;
const pack = tiers[slug as keyof typeof tiers];
const designs = themes.filter((theme) => theme.tier === pack.tier);
const from = rupiah(Math.min(...designs.map((theme) => theme.price)));
---

<Base
  title={`${pack.name} package · Vowlder`}
  description={`${pack.summary} From ${from}, one payment, twelve months live.`}
>
  <main>
    <PageIntro eyebrow={`Package · ${pack.name}`} title={pack.summary} lede={`From ${from}. One payment, no renewal.`}>
      <div class="mt-6 flex flex-col gap-2.5 sm:flex-row sm:items-center sm:gap-3">
        <a
          href={`https://wa.me/${WA_NUMBER}`}
          target="_blank"
          rel="noopener"
          class="press press-active flex min-h-[48px] items-center justify-center rounded-pill bg-ink px-6 text-sm font-medium text-cream hover:bg-ink-soft"
        >
          Order {pack.name}
        </a>
        <a
          href="/packages"
          class="flex min-h-[48px] items-center justify-center rounded-pill border border-ink/20 px-6 text-sm font-medium hover:border-ink/50"
        >
          Compare packages
        </a>
      </div>
    </PageIntro>

    <section class="mx-auto max-w-6xl px-5 pb-12 sm:px-8">
      <div class="grid gap-8 lg:grid-cols-2 lg:gap-16">
        <div>
          <p class="eyebrow">In this package</p>
          <ul class="mt-3 divide-y divide-line border-y border-line text-sm">
            {
              pack.lines.map((line) => (
                <li class="flex items-start gap-3 py-3">
                  <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-brass" />
                  <span>{line}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <p class="eyebrow">Not included</p>
          <ul class="mt-3 divide-y divide-line border-y border-line text-sm text-ink-soft">
            {
              pack.notIncluded.map((line) => (
                <li class="flex items-start gap-3 py-3">
                  <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-line" />
                  <span>{line}</span>
                </li>
              ))
            }
          </ul>

          <p class="eyebrow mt-7">Also in every package</p>
          <ul class="mt-3 grid gap-1.5 text-sm text-ink-soft sm:grid-cols-2">
            {
              includedFeatures.map((feature) => (
                <li class="leading-relaxed">{feature}</li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="border-t border-line">
      <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
        <p class="eyebrow">{designs.length} designs in {pack.name}</p>
        <div class="mt-5 grid grid-cols-1 gap-y-6 sm:grid-cols-2 sm:gap-x-7 sm:gap-y-12 lg:grid-cols-3">
          {designs.map((theme) => <ThemeCard theme={theme} level={2} />)}
        </div>
      </div>
    </section>

    <ContactCta title={`Ready to start with ${pack.name}?`} body="Send the date and the venue. We will confirm availability the same day." />
  </main>
</Base>
