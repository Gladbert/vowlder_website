{
  // Cloudflare Workers with static assets. `bun run deploy` builds first.
  // Set SITE_URL at build time so canonical + og:image use the real domain.
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "vowlder-website",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
